# Ogere Remo Portal — Environment Configuration
# Copy this file to .env and fill in your values.

# Anthropic API key for AI-powered welcome messages and forum moderation.
# If not set, AI features will gracefully fall back to static messages.
VITE_ANTHROPIC_API_KEY=

# Admin panel password (default: ogere2026).
# Change this in production.
VITE_ADMIN_PASSWORD=

# OpenRouter API key for AI Chat Assistant, semantic search, and other AI features.
# Get a free key at https://openrouter.ai/keys
# If not set, AI features will gracefully fall back.
VITE_OPENROUTER_API_KEY=
