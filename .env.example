# ==============================================================================
# Ogere Remo Community Portal — Production Environment Configuration
# Copy this file to .env or set these in your deployment dashboard (e.g. Vercel)
# ==============================================================================

# Database Connection (Neon / Supabase / AWS RDS PostgreSQL)
# Required for serverless APIs in production
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Alternative connection alias (supported by Vercel Postgres / Neon)
POSTGRES_URL=

# SSL Configuration for PostgreSQL (default 'false' for AWS/Neon managed certificates)
DATABASE_SSL_REJECT_UNAUTHORIZED=false
PG_MAX_POOL=10

# Coming Soon Launch Gate:
# 'false' (default) = Portal is fully open to all citizens & diaspora
# 'true' = Enforces coming soon countdown gate with stakeholder PIN unlock
VITE_COMING_SOON=false

# Admin Panel Authentication
# Master password for /admin dashboard access
VITE_ADMIN_PASSWORD=ogere2026

# Paystack Payment Gateway (Marketplace, Donations, ID Card Issuance)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# Artificial Intelligence (AI Chat Assistant, Search, Semantic Q&A)
# OpenRouter API Key (https://openrouter.ai/keys)
VITE_OPENROUTER_API_KEY=
# Anthropic Claude API Key (optional fallback)
VITE_ANTHROPIC_API_KEY=

# Production Domain & Metadata
VITE_SITE_URL=https://ogeremo.org
